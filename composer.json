{
    "name": "brixion/kolibri-sdk-php",
    "description": "PHP SDK for the Kolibri24 REST API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "kolibri",
        "kolibri24",
        "real-estate",
        "api",
        "sdk",
        "rest",
        "php"
    ],
    "homepage": "https://github.com/brixion/kolibri-sdk-php",
    "authors": [
        {
            "name": "Ricky Heijnen",
            "email": "ricky@brixion.com",
            "homepage": "https://github.com/brixion"
        }
    ],
    "support": {
        "issues": "https://github.com/brixion/kolibri-sdk-php/issues",
        "source": "https://github.com/brixion/kolibri-sdk-php"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Brixion\\Kolibri\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Brixion\\Kolibri\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse --configuration=phpstan.neon",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
